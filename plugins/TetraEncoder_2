slider24:s_el2=19.4712<-90,90,0.01>Custom Ch2 El (deg)
slider25:s_az3=0<-180,180,0.01>Custom Ch3 Az (deg)
slider26:s_el3=-90<-90,90,0.01>Custom Ch3 El (deg)
slider27:s_az4=-120<-180,180,0.01>Custom Ch4 Az (deg)
slider28:s_el4=19.4712<-90,90,0.01>Custom Ch4 El (deg)

@init
DEG2RAD = $pi / 180;
NSRC = 4;
MAXCH = 121;

// Memory layout
src_x = 0;
src_y = 4;
src_z = 8;
matrix = 16;

// ----- Math helpers ---------------------------------------------------------
function fact_fn(n) local(r, i)
(
  r = 1; i = 2;
  while(i <= n) (r *= i; i += 1;);
  r;
);

function alp(n, m, x) local(pmm, somx2, fac, pmm1, pll, ll)
(
  pmm = 1;
  m > 0 ? (
    somx2 = sqrt(max(0, (1 - x) * (1 + x)));
    fac = 1;
    loop(m,
      pmm *= fac * somx2;
      fac += 2;
    );
  );
  n == m ? (
    pmm;
  ) : (
    pmm1 = x * (2*m + 1) * pmm;
    n == m + 1 ? (
      pmm1;
    ) : (
      ll = m + 2;
      while(ll <= n) (
        pll = ((2*ll - 1) * x * pmm1 - (ll + m - 1) * pmm) / (ll - m);
        pmm = pmm1;
        pmm1 = pll;
        ll += 1;
      );
      pll;
    );
  );
);

function real_sh_sn3d(n, m, az, el) local(am, leg, ang, norm)
(
  am = abs(m);
  leg = alp(n, am, sin(el));
  ang = m >= 0 ? cos(m * az) : sin(am * az);
  norm = sqrt((m == 0 ? 1 : 2) * fact_fn(n - am) / fact_fn(n + am));
  norm * leg * ang;
);

function rotate_pos(xp, yp, zp, yaw, pitch, roll)
  local(cy, sy, cp, sp, cr, sr, x1, y1, z1, x2, y2, z2)
(
  cy = cos(yaw);   sy = sin(yaw);
  cp = cos(pitch); sp = sin(pitch);
  cr = cos(roll);  sr = sin(roll);

  x1 = xp;
  y1 = yp*cr - zp*sr;
  z1 = yp*sr + zp*cr;

  x2 = x1*cp + z1*sp;
  y2 = y1;
  z2 = -x1*sp + z1*cp;

  rot_x = x2*cy - y2*sy;
  rot_y = x2*sy + y2*cy;
  rot_z = z2;
);

// ----- Geometry: place source unit vector from az/el -----------------------
function set_src(i, az_deg, el_deg) local(az, el, ce)
(
  az = az_deg * DEG2RAD;
  el = el_deg * DEG2RAD;
  ce = cos(el);
  src_x[i] = cos(az) * ce;
  src_y[i] = sin(az) * ce;
  src_z[i] = sin(el);
);

// ----- Load source positions based on selected preset ----------------------
function load_array_preset()
(
  s_array == 0 ? (
    // Stand-Mount: Ch3 straight down
    set_src(0,  120,  19.4712);  // Thumb  | Back-Left-Up
    set_src(1,    0,  19.4712);  // Index  | Forward-Up
    set_src(2,    0, -90      );  // Middle | Straight Down
    set_src(3, -120,  19.4712);  // Ring   | Back-Right-Up
  ) : s_array == 1 ? (
    // Alt-Azimuth: front/back upper pair, left/right lower pair
    set_src(0,  180,  35.2644);    // Thumb  | Back-Up
    set_src(1,    0,  35.2644);    // Index  | Forward-Up
    set_src(2,   90, -35.2644);    // Middle | Right-Down
    set_src(3,  -90, -35.2644);    // Ring   | Left-Down
  ) : (
    // Custom: user-defined per-channel
    set_src(0, s_az1, s_el1);
    set_src(1, s_az2, s_el2);
    set_src(2, s_az3, s_el3);
    set_src(3, s_az4, s_el4);
  );
);

// ----- Build the encoding matrix --------------------------------------------
function build_matrix()
  local(src, n, m, acn, x, y, z, az, el, sh, n3d_scale, ambi_order)
(
  load_array_preset();
  ambi_order = s_order + 1;
  src = 0;
  while(src < NSRC) (
    rotate_pos(src_x[src], src_y[src], src_z[src],
               s_yaw * DEG2RAD, s_pitch * DEG2RAD, s_roll * DEG2RAD);
    x = rot_x; y = rot_y; z = rot_z;

    s_invert ? (x = -x; y = -y; z = -z);

    az = atan2(y, x);
    el = asin(max(-1, min(1, z)));

    n = 0;
    while(n <= ambi_order) (
      n3d_scale = s_norm == 1 ? sqrt(2*n + 1) : 1;
      m = -n;
      while(m <= n) (
        acn = n*n + n + m;
        sh = real_sh_sn3d(n, m, az, el) * n3d_scale;
        matrix[src * MAXCH + acn] = sh;
        m += 1;
      );
      n += 1;
    );
    src += 1;
  );
);

build_matrix();

@slider
g1 = s_mute1 ? 0 : 10^(s_trim1 / 20);
g2 = s_mute2 ? 0 : 10^(s_trim2 / 20);
g3 = s_mute3 ? 0 : 10^(s_trim3 / 20);
g4 = s_mute4 ? 0 : 10^(s_trim4 / 20);
gain_lin = 10^(s_gain / 20);
ambi_order = s_order + 1;
n_active = (ambi_order + 1) * (ambi_order + 1);
build_matrix();

@sample
in0 = spl0 * g1;
in1 = spl1 * g2;
in2 = spl2 * g3;
in3 = spl3 * g4;

ch = 0;
while(ch < n_active) (
  spl(ch) = gain_lin * (
    in0 * matrix[0 * MAXCH + ch] +
    in1 * matrix[1 * MAXCH + ch] +
    in2 * matrix[2 * MAXCH + ch] +
    in3 * matrix[3 * MAXCH + ch]
  );
  ch += 1;
);
while(ch < MAXCH) (
  spl(ch) = 0;
  ch += 1;
);
